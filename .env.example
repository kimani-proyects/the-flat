# Copia este archivo a .env.local y rellena los valores reales.
# Para obtenerlos: ver SETUP.md, paso "Crear proyecto Supabase".

# Supabase — URL y anon key de tu proyecto (supabase.com → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Solo en server, nunca exponer al cliente. Úsalo para admin dashboard y operaciones privilegiadas.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# API de clima de Sevilla (opcional por ahora, se usa más adelante)
# https://openweathermap.org/api — plan gratuito suficiente
OPENWEATHER_API_KEY=
